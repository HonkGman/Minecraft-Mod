# Copy this file to .env and fill in your values.
# On iPhone: set these as environment variables in Railway/Render instead.

DISCORD_TOKEN=your_bot_token_from_discord_developer_portal
CLIENT_ID=your_application_id_from_developer_portal
GUILD_ID=your_discord_server_id

# Optional: channel ID for join logs (or use /setlogchannel in Discord)
LOG_CHANNEL_ID=
